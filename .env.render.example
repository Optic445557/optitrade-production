# Render production values for OptiTrade
# This file contains NO secrets. Put the real values in Render Environment.

NODE_ENV=production
TRUST_PROXY=true
DB_PATH=/var/data/optitrade.db
BACKUP_DIR=/var/data/backups
APP_BASE_URL=https://optiprotrade.online
HSTS_ENABLED=true

ADMIN_EMAIL=
ADMIN_PASSWORD=
SUPPORT_EMAIL=

EMAIL_PROVIDER=resend
EMAIL_SMTP_FALLBACK=false
RESEND_API_KEY=
RESEND_FROM=

SESSION_SECRET=
OTP_PEPPER=

TELEGRAM_ENCRYPTION_KEY=

WALLETCONNECT_PROJECT_ID=
ETHERSCAN_API_KEY=
RPC_ETHEREUM=
RPC_BASE=
RPC_ARBITRUM=
RPC_OPTIMISM=
RPC_BSC=
RPC_POLYGON=

IP_GEOLOCATION_ENABLED=true

SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_LEVEL_NAME=basic-kyc-level

KRAKEN_API_KEY=
KRAKEN_API_SECRET=
