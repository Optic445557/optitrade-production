# OptiTrade production environment for Render
# Never commit real secret values.

NODE_ENV=production
TRUST_PROXY=true
DB_PATH=/var/data/optitrade.db
BACKUP_DIR=/var/data/backups
APP_BASE_URL=https://optiprotrade.online
HSTS_ENABLED=true

# First production Super Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Customer-facing support address
SUPPORT_EMAIL=

# OptiTrade branded email via verified Resend domain
EMAIL_PROVIDER=resend
EMAIL_SMTP_FALLBACK=false
RESEND_API_KEY=
RESEND_FROM=

# Render can generate both secrets automatically.
SESSION_SECRET=
OTP_PEPPER=

# Optional integrations — add only when you are ready to use them.
TELEGRAM_ENCRYPTION_KEY=
WALLETCONNECT_PROJECT_ID=
ETHERSCAN_API_KEY=
RPC_ETHEREUM=
RPC_BASE=
RPC_ARBITRUM=
RPC_OPTIMISM=
RPC_BSC=
RPC_POLYGON=

IP_GEOLOCATION_ENABLED=true

# Optional KYC / AML provider (Sumsub)
SUMSUB_API_BASE=https://api.sumsub.com
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_LEVEL_NAME=basic-kyc-level

# Optional Kraken connector
KRAKEN_API_BASE=https://api.kraken.com
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
